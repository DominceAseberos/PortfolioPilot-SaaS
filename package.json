{
  "name": "portfoliopilot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS='--max-old-space-size=8192' next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:pdf": "tsx src/tests/pdf/resume-pdf-regression.ts",
    "test:template-corpus": "cross-env PDF_REGRESSION_TEST=1 tsx src/tests/pdf/resume-template-corpus-regression.tsx",
    "test:resume-reliability": "tsx src/tests/pdf/resume-reliability-gate.ts",
    "test:pdf-adversarial": "cross-env PDF_REGRESSION_TEST=1 tsx src/tests/pdf/resume-pdf-adversarial-regression.ts",
    "test:sanitized-resume-fixtures": "cross-env PDF_REGRESSION_TEST=1 tsx src/tests/pdf/sanitized-resume-fixture-regression.tsx",
    "test:sanitized-fixture-intake": "cross-env PDF_REGRESSION_TEST=1 tsx src/tests/pdf/sanitized-resume-fixture-selftest.ts",
    "test:watch": "jest --watch",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "prepare": "husky",
    "test:e2e": "playwright test",
    "test:production-gate": "npm run lint && npm run type-check && npm test -- --runInBand && npm run test:sanitized-fixture-intake && npm run test:resume-reliability && npm run test:e2e && npm run build"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@react-pdf/renderer": "^4.5.1",
    "@stripe/stripe-js": "^9.8.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lenis": "^1.3.25",
    "linkifyjs": "^4.3.3",
    "lucide-react": "^1.17.0",
    "next": "16.2.9",
    "openai": "^6.42.0",
    "pdf-parse": "^2.4.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.78.0",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "stripe": "^22.2.0",
    "tailwind-merge": "^3.6.0",
    "tldts": "^7.4.3",
    "turndown": "^7.2.4",
    "unpdf": "^1.6.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/stripe": "^8.0.416",
    "@types/turndown": "^5.0.6",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "lint-staged": "^16.4.0",
    "playwright": "^1.60.0",
    "prettier": "^3.8.4",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.11",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
