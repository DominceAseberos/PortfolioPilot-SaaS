# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# GitHub (optional but recommended)
# Without this: 60 requests/hour, no contribution graph data
# With this:    5000 requests/hour, full streak/commit data
GITHUB_TOKEN=ghp_...

# Groq (free AI inference, optional but recommended)
# Get a free key at https://console.groq.com
GROQ_API_KEY=gsk_...

# Stripe (required for billing)
# Get test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe webhook secret (required for subscription activation)
# Run this command in a terminal to start listening:
#   stripe listen --forward-to localhost:3000/api/webhooks/stripe
# Then copy the "whsec_..." secret from the output and paste it here
STRIPE_WEBHOOK_SECRET=whsec_...

# Supabase (required for admin operations like webhooks)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe price IDs (set these to your actual Stripe price IDs)
# Create a product + price in Stripe dashboard, then paste the price ID here
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=price_...
